{
  "name": "tako-browser",
  "version": "0.3.0-beta.6",
  "description": "Tako.Browser — браузер с кастомизацией, заметками и встроенным VPN",
  "author": "takao",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.takao.browser",
    "productName": "Tako.Browser",
    "executableName": "TakoBrowser",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "files": [
      "main.js",
      "vpn.js",
      "search.js",
      "features.js",
      "adblock.js",
      "extensions.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "styles-handmade.css",
      "common.css",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tako.Browser",
      "artifactName": "Tako.Browser-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "soqu4c",
        "repo": "Tako.Browser"
      }
    ]
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@mozilla/readability": "^0.6.0",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.3.9"
  }
}
